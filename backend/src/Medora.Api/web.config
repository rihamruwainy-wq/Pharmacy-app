<?xml version="1.0" encoding="utf-8"?>
<!-- IIS hosting (MonsterASP.NET and other Windows hosts). Ignored by Docker/Linux. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Medora.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Workstation GC: fits the 256 MB free plan (server GC reserves far more memory). -->
          <environmentVariable name="DOTNET_gcServer" value="0" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
